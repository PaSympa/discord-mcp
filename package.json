{
  "name": "@pasympa/discord-mcp",
  "version": "2.3.0",
  "mcpName": "io.github.PaSympa/discord-mcp",
  "description": "Discord MCP server for Claude, Codex, Cursor and VS Code: read and send messages, moderate members, manage roles, channels, forums, webhooks and events. Toolset profiles, guild allow-list, dry-run for mass actions.",
  "main": "dist/index.js",
  "type": "commonjs",
  "bin": {
    "discord-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "SECURITY.md",
    "Dockerfile"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.ts",
    "site": "node site/generate.mjs",
    "bundle": "node scripts/bundle.mjs",
    "version": "node scripts/sync-version.js && git add server.json manifest.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord-mcp",
    "discord-api",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "codex",
    "cursor",
    "vscode",
    "windsurf",
    "ai",
    "ai-agents",
    "moderation",
    "bot"
  ],
  "author": "PaSympa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PaSympa/discord-mcp"
  },
  "homepage": "https://github.com/PaSympa/discord-mcp#readme",
  "bugs": {
    "url": "https://github.com/PaSympa/discord-mcp/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "discord.js": "^14.26.4",
    "dotenv": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
